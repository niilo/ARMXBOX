<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.niilo.ARMXBOX</id>
  <name>ARMXBOX</name>
  <summary>Original Xbox Emulator</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-2.0-only</project_license>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>gamepad</control>
  </supports>
  <description>
    <p>
       ARMXBOX is a free and open-source application based on xemu and QEMU that emulates the original Microsoft Xbox game console. Supports connecting up to 4 controllers for local play, networking for multiplayer, resolution scaling, and more.
    </p>
  </description>
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <content_rating type="oars-1.1"/>
  <url type="homepage">https://github.com/niilo/ARMXBOX</url>
  <url type="bugtracker">https://github.com/niilo/ARMXBOX/issues</url>
  <url type="help">https://github.com/niilo/ARMXBOX#readme</url>
  <url type="faq">https://github.com/niilo/ARMXBOX#setup-requirements-user-files</url>
  <launchable type="desktop-id">armxbox.desktop</launchable>
  <provides>
    <binary>armxbox</binary>
  </provides>
  <developer id="io.github.niilo">
    <name>ARMXBOX contributors</name>
  </developer>
</component>
