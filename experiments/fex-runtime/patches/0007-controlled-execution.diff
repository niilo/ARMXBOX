+ExecutionResult ContextImpl::ExecuteControlledThread(Core::InternalThreadState* Thread, uint64_t Budget) {
+  static_assert(std::atomic_ref<uint32_t>::is_always_lock_free);
+  static_assert(offsetof(Core::CpuStateFrame, ExecutionControlState) % std::atomic_ref<uint32_t>::required_alignment == 0);
+  if (!InstructionCheckpoints || !Thread || Thread->CTX != this) {
+    return ExecutionResult::Unsupported;
+  }
+  auto Frame = Thread->CurrentFrame;
+  auto State = std::atomic_ref(Frame->ExecutionControlState);
+  uint32_t Previous = State.load(std::memory_order_acquire);
+  do {
+    if (Previous & 1) {
+      return ExecutionResult::Busy;
+    }
+  } while (!State.compare_exchange_weak(Previous, Previous | 1, std::memory_order_acq_rel));
+  Frame->ExecutionControlReason = 0;
+  Frame->ExecutionInstructionsRemaining = Budget;
+  Frame->SynchronousFaultData = {};
+  if (State.load(std::memory_order_acquire) & 2) {
+    Frame->ExecutionControlReason = static_cast<uint32_t>(ExecutionResult::StopRequested);
+  } else if (!Budget) {
+    Frame->ExecutionControlReason = static_cast<uint32_t>(ExecutionResult::BudgetExhausted);
+  } else {
+    Frame->Pointers.ThunkCallbackRet = SignalDelegation->GetThunkCallbackRET();
+    Dispatcher->ExecuteDispatch(Frame);
+  }
+  const auto Result = static_cast<ExecutionResult>(Frame->ExecutionControlReason);
+  State.fetch_and(~1U, std::memory_order_release);
+  return Result;
+}
+
+bool ContextImpl::RequestStop(Core::InternalThreadState* Thread) {
+  if (!InstructionCheckpoints || !Thread || Thread->CTX != this) {
+    return false;
+  }
+  std::atomic_ref(Thread->CurrentFrame->ExecutionControlState).fetch_or(2, std::memory_order_release);
+  return true;
+}
+
+bool ContextImpl::ResetStopRequest(Core::InternalThreadState* Thread) {
+  if (!InstructionCheckpoints || !Thread || Thread->CTX != this) {
+    return false;
+  }
+  auto State = std::atomic_ref(Thread->CurrentFrame->ExecutionControlState);
+  uint32_t Previous = State.load(std::memory_order_acquire);
+  do {
+    if (Previous & 1) {
+      return false;
+    }
+  } while (!State.compare_exchange_weak(Previous, 0, std::memory_order_acq_rel));
+  return true;
+}
