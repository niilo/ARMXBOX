+DEF_OP(ExecutionCheckpoint) {
+  const auto Op = IROp->C<IR::IROp_ExecutionCheckpoint>();
+  using Frame = Core::CpuStateFrame;
+  ARMEmitter::ForwardLabel Requested, Budget, Stop, Continue;
+  add(ARMEmitter::Size::i64Bit, TMP2, STATE, offsetof(Frame, ExecutionControlState));
+  ldar(TMP1.W(), TMP2);
+  tbnz(TMP1.W(), 1, &Requested);
+  ldr(TMP1, STATE, offsetof(Frame, ExecutionInstructionsRemaining));
+  cbz(ARMEmitter::Size::i64Bit, TMP1, &Budget);
+  sub(ARMEmitter::Size::i64Bit, TMP1, TMP1, 1);
+  str(TMP1, STATE, offsetof(Frame, ExecutionInstructionsRemaining));
+  b(&Continue);
+  BindOrRestart(&Requested);
+  LoadConstant(ARMEmitter::Size::i32Bit, TMP2, static_cast<uint32_t>(Context::ExecutionResult::StopRequested));
+  b(&Stop);
+  BindOrRestart(&Budget);
+  LoadConstant(ARMEmitter::Size::i32Bit, TMP2, static_cast<uint32_t>(Context::ExecutionResult::BudgetExhausted));
+  BindOrRestart(&Stop);
+  str(TMP2.W(), STATE, offsetof(Frame, ExecutionControlReason));
+  str(GetReg(Op->GuestPC).X(), STATE, offsetof(Frame, State.rip));
+  ResetStack();
+  str(ARMEmitter::XReg::zr, STATE, offsetof(Frame, SynchronousFaultData));
+  ldr(TMP1, STATE, offsetof(Frame, Pointers.ThreadStopHandlerSpillSRA));
+  br(TMP1);
+  BindOrRestart(&Continue);
+}
