+
+// Single-use embedding initialization, before creating any guest threads. The
+// reservation and allocator are process-owned, as with the legacy hooks.
+bool SetupBoundedHooks(size_t PageSize, size_t ArenaSize, uintptr_t& ArenaBase) {
+  ArenaBase = 0;
+  constexpr size_t MetadataSize = 64 * 1024 * 1024;
+  if (PageSize != FEXCore::Utils::FEX_PAGE_SIZE || sysconf(_SC_PAGESIZE) != static_cast<long>(PageSize) ||
+      ArenaSize < 128ULL * 1024 * 1024 || ArenaSize > (1ULL << 32) || (ArenaSize & (PageSize - 1))) {
+    errno = EINVAL;
+    return false;
+  }
+  if (BoundedSetupClaim.test_and_set()) {
+    errno = EBUSY;
+    return false;
+  }
+  if (Alloc64 || BoundedAlloc64) {
+    BoundedSetupClaim.clear();
+    errno = EBUSY;
+    return false;
+  }
+  // A kernel-chosen reservation cannot replace live host mappings, including
+  // mappings concurrently created by Android. Do not scan and steal VA gaps.
+  void* Reservation = ::mmap(nullptr, ArenaSize, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+  const uintptr_t Begin = reinterpret_cast<uintptr_t>(Reservation);
+  if (Reservation == MAP_FAILED || Begin < (1ULL << 32) || Begin > UINTPTR_MAX - ArenaSize) {
+    const int Error = Reservation == MAP_FAILED ? errno : ENOMEM;
+    if (Reservation != MAP_FAILED) ::munmap(Reservation, ArenaSize);
+    BoundedSetupClaim.clear();
+    errno = Error;
+    return false;
