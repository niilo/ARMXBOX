+    BoundedSetupClaim.clear();
+    errno = Error;
+    return false;
+  }
+  fextl::vector<MemoryRegion> Regions {{Reservation, ArenaSize}};
+  BoundedAlloc64 = Alloc::OSAllocator::Create64BitAllocatorWithRegions(Regions).release();
+  BoundedBegin = Begin;
+  BoundedEnd = Begin + ArenaSize;
+  AssignHookOverrides(PageSize);
+  ArenaBase = Begin;
+  return true;
