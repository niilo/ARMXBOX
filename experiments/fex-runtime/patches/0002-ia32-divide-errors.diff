+// IA-32 DIV/IDIV need precise #DE exits before committing quotient/remainder.
+// Native AArch64 division itself does not trap on zero or signed overflow.
+void OpDispatchBuilder::IA32DivideOp(OpcodeArgs, bool Signed) {
+  const auto Size = OpSizeFromSrc(Op);
+  const auto Bits = IR::OpSizeAsBits(Size);
+  LOGMAN_THROW_A_FMT(Bits == 8 || Bits == 16 || Bits == 32, "Invalid IA-32 divide width");
+
+  Ref Divisor {}, High {}, Dividend {};
+  auto LoadOperands = [&] {
+    Ref RawDivisor = LoadSourceGPR(Op, Op->Dest, Op->Flags);
+    Divisor = Signed ? _Sbfe(OpSize::i64Bit, Bits, 0, RawDivisor) : _Bfe(OpSize::i64Bit, Bits, 0, RawDivisor);
+    Ref Low = LoadGPRRegister(X86State::REG_RAX);
+    High = Bits == 8 ? _Bfe(OpSize::i64Bit, 8, 8, Low) : _Bfe(OpSize::i64Bit, Bits, 0, LoadGPRRegister(X86State::REG_RDX));
+    Low = _Bfe(OpSize::i64Bit, Bits, 0, Low);
+    Dividend = _Bfi(OpSize::i64Bit, Bits, Bits, Low, High);
+    if (Signed && Bits < 32) Dividend = _Sbfe(OpSize::i64Bit, Bits * 2, 0, Dividend);
+  };
+  LoadOperands();
+  Ref InvalidDivision {};
+  if (Signed) {
+    auto NMask = _Ashr(OpSize::i64Bit, Dividend, Constant(63));
+    auto DMask = _Ashr(OpSize::i64Bit, Divisor, Constant(63));
+    auto AbsN = _Sub(OpSize::i64Bit, _Xor(OpSize::i64Bit, Dividend, NMask), NMask);
+    auto AbsD = _Sub(OpSize::i64Bit, _Xor(OpSize::i64Bit, Divisor, DMask), DMask);
+    auto Negative = _And(OpSize::i64Bit, _Xor(OpSize::i64Bit, NMask, DMask), Constant(1));
+    // Truncation toward zero permits magnitude 2^(w-1) only for a negative
+    // quotient. The first invalid magnitude times |divisor| fits in uint64_t
+    // for IA-32 widths, even when the dividend is INT64_MIN. Divisor zero
+    // gives threshold zero and is therefore rejected by the same comparison.
+    auto Limit = _Add(OpSize::i64Bit, Constant(1ULL << (Bits - 1)), Negative);
+    auto Threshold = _Mul(OpSize::i64Bit, Limit, AbsD);
+    InvalidDivision = _Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::UGE, AbsN, Threshold, Constant(1), Constant(0));
+  } else {
+    InvalidDivision = _Select(OpSize::i64Bit, OpSize::i64Bit, CondClass::UGE, High, Divisor, Constant(1), Constant(0));
+  }
+  // Keep the checked operands in one IR block. In particular, a memory
+  // divisor must be read exactly once (MMIO and concurrent RAM included).
+  FlushRegisterCache();
+  _CondBreak(InvalidDivision, GetRelocatedPC(Op, -Op->InstSize),
+             FEXCore::IR::BreakDefinition {.ErrorRegister = 0, .Signal = SIGFPE, .TrapNumber = X86State::X86_TRAPNO_DE, .si_code = FPE_INTDIV});
+  Ref Quotient = _AllocateGPR(true);
+  Ref Remainder = _AllocateGPR(true);
+  if (Signed) {
+    _Div(OpSize::i64Bit, Dividend, Invalid(), Divisor, Quotient, Remainder);
+  } else {
+    _UDiv(OpSize::i64Bit, Dividend, Invalid(), Divisor, Quotient, Remainder);
+  }
+  if (Bits == 8) {
+    auto AX = _Bfi(GetGPROpSize(), 8, 8, Quotient, Remainder);
+    StoreGPRRegister(X86State::REG_RAX, AX, OpSize::i16Bit);
+  } else {
+    if (Bits == 32) {
+      // Pair destinations are 64-bit IR values; maintain canonical IA-32
+      // zero-extension exactly as the original 32-bit dispatcher path does.
+      Quotient = _Bfe(OpSize::i32Bit, 32, 0, Quotient);
+      Remainder = _Bfe(OpSize::i32Bit, 32, 0, Remainder);
+    }
+    StoreGPRRegister(X86State::REG_RAX, Quotient, Size);
+    StoreGPRRegister(X86State::REG_RDX, Remainder, Size);
+  }
+  AcidTestFlags(X86State::RFLAG_OF_RAW_LOC, X86State::RFLAG_SF_RAW_LOC, X86State::RFLAG_ZF_RAW_LOC, X86State::RFLAG_AF_RAW_LOC,
+                X86State::RFLAG_PF_RAW_LOC, X86State::RFLAG_CF_RAW_LOC);
+}
